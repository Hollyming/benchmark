{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryChallengeQuery",
  "type": "object",
  "required": ["query_id", "trajectory_id", "persona_id", "capability", "prompt", "evidence_event_ids", "expected_behavior", "privacy_sensitive"],
  "properties": {
    "query_id": {"type": "string"},
    "trajectory_id": {"type": "string"},
    "persona_id": {"type": "string"},
    "capability": {"type": "string"},
    "prompt": {"type": "string"},
    "answer": {"type": ["string", "null"]},
    "evidence_event_ids": {"type": "array", "items": {"type": "string"}},
    "negative_evidence_event_ids": {"type": "array", "items": {"type": "string"}},
    "obsolete_evidence_event_ids": {"type": "array", "items": {"type": "string"}},
    "distractor_event_ids": {"type": "array", "items": {"type": "string"}},
    "memory_task": {"type": "string"},
    "expected_behavior": {"type": "string"},
    "privacy_sensitive": {"type": "boolean"},
    "rubric": {"type": "object"}
  }
}

